<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's engine-free layers, compiled directly (no Godot SDK):
         data model + roster rules, and save serialization for round-trips.
         The NpcDefinition/NpcItemStack resources and NpcDatabase are
         Godot-facing and excluded; their engine-free core (NpcIndex) stays. -->
    <Compile Include="../Scripts/Data/**/*.cs" LinkBase="GameSource/Data"
             Exclude="../Scripts/Data/NpcDefinition.cs;../Scripts/Data/NpcItemStack.cs;../Scripts/Data/NpcStatBlock.cs;../Scripts/Data/NpcDatabase.cs" />
    <Compile Include="../Scripts/Save/SaveRepository.cs" Link="GameSource/SaveRepository.cs" />
    <!-- Serializable dialogue graph + runtime: the data model, effect/condition
         vocabulary, and graph->DialogueLine compiler are engine-free. The
         DialogueManager node and the res:// DialogueCatalog scan are Godot-facing
         and stay out. -->
    <Compile Include="../Scripts/Dialogue/**/*.cs" LinkBase="GameSource/Dialogue"
             Exclude="../Scripts/Dialogue/DialogueManager.cs;../Scripts/Dialogue/DialogueCatalog.cs" />
    <!-- World-map core: pixel/world math and the baked landmarks format.
         The Godot-facing baker (MapBaker) and streaming (ChunkManager) stay out. -->
    <Compile Include="../Scripts/World/MapProjection.cs" Link="GameSource/MapProjection.cs" />
    <Compile Include="../Scripts/World/MapLandmark.cs" Link="GameSource/MapLandmark.cs" />
    <Compile Include="../Scripts/World/MapBakeManifest.cs" Link="GameSource/MapBakeManifest.cs" />
    <!-- In-game editor console: the engine-free command registry, tokenizer,
         and builtin commands. The DevConsole node itself is Godot-facing. -->
    <Compile Include="../Scripts/Editor/Commands/**/*.cs" LinkBase="GameSource/Editor/Commands" />
    <!-- UI window management: the window policy interface, the open-window
         stack that derives visibility/pointer/gameplay-blocking from it, and
         the layer table. UiWindowManager (the autoload that applies them to
         Godot) stays out. -->
    <Compile Include="../Scripts/Ui/**/*.cs" LinkBase="GameSource/Ui"
             Exclude="../Scripts/Ui/UiWindowManager.cs" />
  </ItemGroup>
</Project>
